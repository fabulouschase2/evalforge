# EvalForge AI backend environment template.
# Copy to .env and adjust. NEVER commit real secrets or API keys.
ENVIRONMENT=development

# PostgreSQL in Docker: postgresql+psycopg://evalforge:evalforge@localhost:5432/evalforge
# Local development default (SQLite):
DATABASE_URL=sqlite:///./evalforge.db

SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
MAX_RECORDS_PER_DATASET=20000

# --- V3 additions ---

# Local storage root for deliverables, attachments and media files.
# Use a dedicated volume in production; an S3 driver is a documented extension point.
EVALFORGE_STORAGE_ROOT=storage

# Email delivery (optional). When SMTP_HOST is unset, notifications stay in-app
# and emails are skipped with a log line — the platform never pretends to send.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=evalforge@example.com
# SMTP_PASSWORD=
# SMTP_FROM=evalforge@example.com
# SMTP_TLS=1

# External API keys are rate-limited in memory (120 req/min per key). Use a
# shared Redis-backed limiter for multi-instance production deployments.
# The webhook delivery worker runs in-process (single-node scale documented).

# Per-IP login attempts allowed per 5-minute window (brute-force baseline).
LOGIN_RATE_LIMIT=60

# Demo seeding: must be explicitly true to allow /api/demo/load in production
# (demo accounts are created with random one-time passwords printed to the console).
ENABLE_DEMO=true
